{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Metronome",
  "version": "1.0.0",
  "identifier": "io.github.gustjrwjs.metronome",
  "build": {
    "beforeBuildCommand": "node scripts/copy-web.mjs",
    "beforeDevCommand": "node scripts/copy-web.mjs",
    "frontendDist": "../app-dist"
  },
  "app": {
    "windows": [
      { "title": "메트로놈", "width": 480, "height": 880, "minWidth": 340, "minHeight": 560, "resizable": true, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "gustjrwjs",
    "copyright": "© 2026 gustjrwjs",
    "shortDescription": "메트로놈",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["Korean"], "displayLanguageSelector": false }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5RDUwRjhBNjIzNkNDOEIKUldTTHpEWmlpZy9WcVVTa2h6SnhhRGlKMDduZU5TYWc0V3ZWQTExSk1tQlRmaGNUaXBIZEwwREQK",
      "endpoints": ["https://github.com/gustjrwjs/metronome/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
